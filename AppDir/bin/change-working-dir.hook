#!/bin/sh

dir="$HOME/.MythII"
export SHARUN_DIR="$APPDIR"
export MYTH2_BASE="$dir"

cd "$dir"
cp "$APPDIR"/sharun    ./
cp "$APPDIR"/.env      ./ 2>/dev/null || :
cp "$APPDIR"/.preload  ./ 2>/dev/null || :

if [ ! -f "$dir/plugins/Patch 1.8.5 Unity" ]; then
  cp -r "$APPDIR/bin/plugins" "$dir"
fi

mkdir -p ./bin
rm -f ./bin/Myth2_64bit
ln -f ./sharun ./bin/Myth2_64bit

for d in lib share shared etc; do
  if [ -d "$APPDIR"/"$d" ]; then
    ln -sfn "$APPDIR"/"$d"  ./"$d"
  fi
done

exec ./bin/Myth2_64bit "$@"
